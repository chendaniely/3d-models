{
  "format": "solidcraft/48",
  "name": "dowel-taper-card",
  "units": "mm",
  "params": [
    {
      "name": "rate",
      "expr": "0.1",
      "unit": "",
      "comment": "how much wider each window gets per millimetre along it",
      "model": false
    },
    {
      "name": "w1_n",
      "expr": "11.0 mm",
      "unit": "mm",
      "comment": "the small window's narrow end",
      "model": false
    },
    {
      "name": "w1_w",
      "expr": "33.0 mm",
      "unit": "mm",
      "comment": "the small window's wide end",
      "model": false
    },
    {
      "name": "w2_n",
      "expr": "31.0 mm",
      "unit": "mm",
      "comment": "the large window's narrow end: it overlaps the small one's top",
      "model": false
    },
    {
      "name": "w2_w",
      "expr": "53.0 mm",
      "unit": "mm",
      "comment": "the large window's wide end",
      "model": false
    },
    {
      "name": "len",
      "expr": "(w1_w - w1_n) / rate",
      "unit": "mm",
      "comment": "each window's length; the two are the same",
      "model": false
    },
    {
      "name": "cos_a",
      "expr": "cos(atan(rate / 2))",
      "unit": "",
      "comment": "a dowel stops where the window is its diameter times this: the ticks sit there",
      "model": false
    },
    {
      "name": "end",
      "expr": "8.0 mm",
      "unit": "mm",
      "comment": "plastic past each window's narrow end",
      "model": false
    },
    {
      "name": "right",
      "expr": "16.0 mm",
      "unit": "mm",
      "comment": "plastic past each window's wide end, where the units are",
      "model": false
    },
    {
      "name": "band",
      "expr": "20.0 mm",
      "unit": "mm",
      "comment": "plastic outside each window, holding its ticks and numbers",
      "model": false
    },
    {
      "name": "mid",
      "expr": "30.0 mm",
      "unit": "mm",
      "comment": "plastic between the windows, holding two scales",
      "model": false
    },
    {
      "name": "thick",
      "expr": "6 mm",
      "unit": "mm",
      "comment": "the card's thickness",
      "model": false
    },
    {
      "name": "engrave",
      "expr": "0.6 mm",
      "unit": "mm",
      "comment": "how deep the ticks and numbers are cut",
      "model": false
    },
    {
      "name": "card_l",
      "expr": "end + len + right",
      "unit": "mm",
      "comment": "the card's length",
      "model": false
    },
    {
      "name": "card_w",
      "expr": "2 * band + w1_w + mid + w2_w",
      "unit": "mm",
      "comment": "the card's width",
      "model": false
    },
    {
      "name": "axis2",
      "expr": "band + w2_w / 2",
      "unit": "mm",
      "comment": "the large window's centre line",
      "model": false
    },
    {
      "name": "axis1",
      "expr": "band + w2_w + mid + w1_w / 2",
      "unit": "mm",
      "comment": "the small window's centre line",
      "model": false
    }
  ],
